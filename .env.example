# Example environment configuration for BioAgentHub_Crawler
# Copy to .env and fill in your own values. Do NOT commit .env.

# OpenAI API key (required for agentic mode when llm.provider=openai)
OPENAI_API_KEY=

# Default OpenAI model for agents / cross-encoder (optional)
OPENAI_MODEL=gpt-4o-mini

# Default OpenAI embedding model (optional)
OPENAI_EMBED_MODEL=text-embedding-3-large

# bioRxiv lookback window in days (optional)
BIORXIV_DAYS_BACK=730
